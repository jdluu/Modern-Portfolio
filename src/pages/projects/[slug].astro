---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import LightboxImage from "@components/ui/LightboxImage.astro";
import "./projects.css";
import {
  sanitizeStringForUI,
  parseSafeDate,
  formatMonthYear,
} from "@lib/utils";
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";

// Astro's image service has no video pipeline, so demo recordings are collected
// with import.meta.glob and imported eagerly. That way Vite emits them as hashed
// assets next to the rest of the project media instead of shipping raw.
const demoVideos = import.meta.glob<string>(
  "/src/assets/images/projects/*/final_*.{mp4,webm}",
  { eager: true, import: "default" },
);
const demoVideoUrl = (projectDir: string, ext: "mp4" | "webm"): string | undefined => {
  const key = Object.keys(demoVideos).find(
    (k) => k.includes(`/projects/${projectDir}/final_`) && k.endsWith(`.${ext}`),
  );
  return key ? demoVideos[key] : undefined;
};

// Generate static paths
export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return (entries ?? [])
    .filter((e: any) => e.data?.draft !== true)
    .map((e: any) => ({
      params: { slug: e.id }
    }));
}

const { slug: slugParam } = Astro.params;

const projectEntries = await getCollection("projects");
const entry = (projectEntries ?? []).find((e: any) => e.id === slugParam) ?? null;

if (!entry) {
  throw new Error(`Project not found for slug: ${slugParam}`);
}
const data = entry.data;

const title = data?.title ?? "Untitled";
const summary = data?.summary ?? data?.description ?? "";
const dateText = (() => {
  const d = parseSafeDate(data?.date);
  return d ? formatMonthYear(d) : (typeof data?.date === "string" ? data.date : "");
})();

const role = data?.role ?? "";
const technologiesText = sanitizeStringForUI(data?.technologies) || "";
const toolsText = sanitizeStringForUI(data?.tools) || "";
const techArray = technologiesText
  ? (String(technologiesText).split(",").map((s) => s.trim()).filter(Boolean))
  : [];
const toolsArray = toolsText
  ? (String(toolsText).split(",").map((s) => s.trim()).filter(Boolean))
  : [];
const coverUrl = data?.cover ?? null;
const finalUrl = data?.final ?? null;

const coverPlaceholder = coverUrl && typeof coverUrl !== 'string' 
  ? await getImage({ src: coverUrl, width: 20, quality: 10, format: 'webp' }) 
  : null;

// Demo recordings share a basename with the `final` image: final_<name>.png is the
// still, final_<name>.mp4/.webm are the captured demo. When a recording exists it
// becomes the Final Product media, and the still is reused as its poster.
const demoWebmUrl = demoVideoUrl(entry.id, "webm");
const demoMp4Url = demoVideoUrl(entry.id, "mp4");
const hasDemoVideo = Boolean(demoWebmUrl || demoMp4Url);

const isAstroImage = finalUrl != null && typeof finalUrl !== "string";

// Routed through Astro's image service so the poster ships optimized, and the
// source's intrinsic size reserves the video box before it loads (no layout shift).
const finalPoster = isAstroImage
  ? await getImage({ src: finalUrl, format: "webp", quality: 75 })
  : null;
const finalDims = isAstroImage ? { width: finalUrl.width, height: finalUrl.height } : null;

const background = data?.background ?? "";
const solution = data?.solution ?? "";
const processText = data?.process ?? "";
const impactText = data?.impact ?? "";
const reflectionText = data?.reflection ?? "";

const liveLink = data?.links?.live ?? "";
const sourceLink = data?.links?.source ?? "";

// Structured data is derived from the case study's categories, so it has to track
// the category set rather than a guess about the platform.
const categories: string[] = data?.categories ?? [];

const PLATFORM_SCHEMA: Record<string, { category: string; os: string }> = {
  Web: { category: "WebApplication", os: "Web" },
  Mobile: { category: "MobileApplication", os: "Android" },
  Desktop: { category: "DesktopApplication", os: "Windows, macOS, Linux" },
  "Data Science": { category: "DataScienceApplication", os: "" },
};

// The first category leads, and the operating systems come from all of them, so a
// cross-platform app is described as running on each platform it actually ships on.
const leadCategory = categories.map((c) => PLATFORM_SCHEMA[c]).find(Boolean);
const operatingSystems = [
  ...new Set(categories.map((c) => PLATFORM_SCHEMA[c]?.os).filter(Boolean)),
].join(", ");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": title,
  "description": summary,
  ...(leadCategory ? { applicationCategory: leadCategory.category } : {}),
  ...(operatingSystems ? { operatingSystem: operatingSystems } : {}),
  "author": {
    "@type": "Person",
    "name": "Jeffrey Luu",
    "url": "https://jluu.dev"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const structuredDataString = JSON.stringify(structuredData);
---

<BaseLayout title={title}>
    <script type="application/ld+json" is:inline set:html={structuredDataString} />
    <div class="project-page-container">
      <div class="project-detail">
        <div class="project-grid">
          <div class="project-content">
            <article class="project-page-div">
                <section id="overview" aria-labelledby="project-title" class="project-section">
                <div class="project-intro-card">
                  {coverUrl ? (
                    <figure class="project-hero" role="img" aria-label={`${title} hero`}>
                      <div 
                        class="project-hero-figure" 
                        style={coverPlaceholder ? {
                          'background-image': `url(${coverPlaceholder.src})`,
                          'background-size': 'cover',
                          'background-position': 'center'
                        } : {}}
                      >
                         {typeof coverUrl === 'string' ? (
                            <img src={coverUrl} alt={`${title} cover`} class="project-hero-img" />
                         ) : (
                            <Image
                              src={coverUrl}
                              alt={`${title} cover`}
                              loading="eager"
                              fetchpriority="high"
                              widths={[800, 1200]}
                              quality={75}
                              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1200px"
                              class="project-hero-img"
                            />
                         )}
                      </div>
                      <div class="project-hero-title">
                        <h1 id="project-title" class="project-title">{title}</h1>
                      </div>
                    </figure>
                  ) : (
                    <h1 id="project-title" class="project-title">{title}</h1>
                  )}

                  <div class="overview-layout">
                    <p class="section-content lead project-summary" set:html={summary?.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}></p>

                    {(liveLink || sourceLink) && (
                      <div class="cta-aside primary-actions">
                        {liveLink && (
                          <a
                            href={liveLink}
                            class="btn btn-primary"
                            target="_blank"
                            rel="noreferrer"
                            aria-label={`View live project: ${title}`}
                          >
                            <Icon name="lucide:external-link" class="btn-icon" />
                            View Live Demo
                          </a>
                        )}

                        {sourceLink && (
                          <a
                            href={sourceLink}
                            class="btn"
                            target="_blank"
                            rel="noreferrer"
                            aria-label={`View source: ${title}`}
                          >
                            <Icon name="lucide:github" class="btn-icon" />
                            Source Code
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </div>

                  <div class="info-row">
                    <div class="card" aria-hidden="false">
                      <h2 class="role-heading">Role</h2>
                      <p class="role-body">{role}</p>
                      <dl class="kv">
                        <dt>Timeline</dt>
                        <dd>{dateText}</dd>
                      </dl>
                    </div>
                    <div class="card">
                      <div class="tt-grid" role="group" aria-label="Technologies and tools">
                        <div class="tt-column" aria-labelledby="tech-label">
                          <h3 id="tech-label" class="tt-subheading">Technologies</h3>
                          {techArray.length > 0 ? (
                            <ul class="tech-list" aria-label="Technologies">
                              {techArray.map((t) => (<li><span class="tech-pill">{t}</span></li>))}
                            </ul>
                          ) : (
                            <p class="section-content">No technologies listed.</p>
                          )}
                        </div>
                        <div class="tt-column" aria-labelledby="tool-label">
                          <h3 id="tool-label" class="tt-subheading">Tools</h3>
                          {toolsArray.length > 0 ? (
                            <ul class="tech-list" aria-label="Tools">
                              {toolsArray.map((t) => (<li><span class="tech-pill">{t}</span></li>))}
                            </ul>
                          ) : (
                            <p class="section-content">No tools listed.</p>
                          )}
                        </div>
                      </div>
                    </div>
                  </div>
                </section>

                <section id="background" class="content-section">
                    <h2>Background</h2>
                    <p class="section-content">{background}</p>
                    
                    <h2>Solution</h2>
                    <p class="section-content">{solution}</p>
                </section>

                <section id="process" class="content-section">
                    <h2>Process</h2>
                    {processText ? (
                      <p class="section-content">{processText}</p>
                    ) : (
                      <p class="section-content">No process details available.</p>
                    )}
                </section>

                <section id="results" class="content-section">
                    <h2>Final Product</h2>
                    {hasDemoVideo ? (
                      <figure class="final-figure">
                        <video
                          width={finalDims?.width}
                          height={finalDims?.height}
                          poster={finalPoster?.src}
                          autoplay
                          loop
                          muted
                          playsinline
                          controls
                          preload="metadata"
                          aria-label={`${title} final product demo`}
                        >
                          {demoWebmUrl && <source src={demoWebmUrl} type="video/webm" />}
                          {demoMp4Url && <source src={demoMp4Url} type="video/mp4" />}
                        </video>
                      </figure>
                    ) : finalUrl ? (
                      <div class="final-figure-wrapper">
                        <LightboxImage src={finalUrl} alt={`${title} final product`} />
                      </div>
                    ) : (
                      <p class="section-content">No final product media available.</p>
                    )}
                    {impactText && (
                      <div id="impact">
                        <h2>Impact</h2>
                        <p class="section-content">{impactText}</p>
                      </div>
                    )}
                </section>

                <section id="reflection" class="content-section">
                    <h2>Reflection</h2>
                    {reflectionText ? (
                      <p class="section-content">{reflectionText}</p>
                    ) : (
                      <p class="section-content">No reflections available.</p>
                    )}


                </section>
            </article>
          </div>
          <!-- Sticky TOC card -->
          <aside class="project-toc" aria-label="Table of contents">
            <div class="toc-card" role="navigation" aria-labelledby="toc-label">
              <div class="toc-header" aria-hidden="false">
                <h2 id="toc-label">Table of Contents</h2>
                <button id="toc-toggle" class="toc-toggle" aria-expanded="true" aria-label="Collapse Table of Contents">−</button>
              </div>
              <ul class="toc-list">
                <li><a href="#overview">Overview</a></li>
                <li><a href="#background">Background</a></li>
                <li><a href="#process">Process</a></li>
                <li><a href="#results">Final Product</a></li>
                <li><a href="#reflection">Reflection</a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </div>
</BaseLayout>

<script>
  import { initToc } from "@scripts/toc";

  // Register on astro:page-load as well as on first load. ClientRouter swaps the
  // document on client-side navigation and DOMContentLoaded never fires again, so
  // a visitor arriving by clicking through the site got a dead toggle, no mobile
  // default-collapse, and no scroll-spy. The data-tocInit guard inside initToc
  // makes the second call a no-op.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => initToc(), {
      once: true,
    });
  } else {
    initToc();
  }
  document.addEventListener("astro:page-load", () => initToc());

  // Autoplaying demo loops honor a reduced-motion preference, re-applied on
  // astro:page-load because a video the router swaps in is a fresh element that
  // would otherwise start autoplaying.
  const applyReducedMotion = () => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document
      .querySelectorAll<HTMLVideoElement>(".final-figure video")
      .forEach((video) => {
        video.autoplay = false;
        video.removeAttribute("autoplay");
        video.pause();
      });
  };
  applyReducedMotion();
  document.addEventListener("astro:page-load", applyReducedMotion);
</script>
