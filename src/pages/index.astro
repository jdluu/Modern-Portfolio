---
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeSection from "@components/sections/HomeSection.astro";

// Page title
const pageTitle = "Jeffrey Luu — Software Developer | Portfolio";

/* Structured Data (JSON-LD) for the homepage.
   Extracted into a named constant for readability while preserving
   identical output via JSON.stringify below.
*/
const _structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Jeffrey Luu",
    jobTitle: "Software Developer",
    url: "https://jluu.dev",
    description:
      "Jeffrey Luu builds practical software — Android apps, terminal tools, and on-device AI. M.S. CS at CSULB, HCI at UCSD.",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Jeffrey Luu Portfolio",
    url: "https://jluu.dev",
    inLanguage: "en",
  },
];

const structuredDataString = JSON.stringify(_structuredData);
---

<BaseLayout title={pageTitle} isHomepage={true}>
  <HomeSection />
  <script type="application/ld+json" is:inline set:html={structuredDataString} />
</BaseLayout>
