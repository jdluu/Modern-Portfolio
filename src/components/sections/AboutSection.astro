---
import { getCollection } from "astro:content";
import "./AboutSection.css";

import type { PostEntry } from "@/src/content.config";

// Check if coursework posts are published (not drafts)
const posts = await getCollection("posts");
const ucsdPost = posts.find((p: { id: string; data: PostEntry }) => p.id === "ucsd-coursework" && p.data.draft !== true);
const csulbPost = posts.find((p: { id: string; data: PostEntry }) => p.id === "csulb-coursework" && p.data.draft !== true);
---
<section class="content-section" aria-labelledby="about">
        <h2 id="about" class="page-h2">About Me</h2>
        <div id="flex-container" role="main">
                <div id="about-wrapper">
                        <p id="about-desc">
                                <span class="intro-text">Hi, I'm Jeffrey Luu.</span> I'm finishing an M.S. in
                                Computer Science at Cal State Long Beach on top of a B.S. in Human Computer
                                Interaction from UC San Diego. Half engineer, half person who worries about
                                whether the interface makes sense.
                                <br />
                                <br />
                                My research trains AI agents in Unity simulations using reinforcement
                                learning and reward shaping, mostly getting them to cooperate instead of
                                trip over each other.
                                <br />
                                <br />
                                Outside the lab I build small tools for myself: a terminal launcher, an ebook
                                sync app, an offline workout coach. The ones that stick get shipped.
                        </p>

                        <div class="cta-card" role="note" aria-label="Projects call to action">
                                <p class="projects-text">Enough about me.</p>
                                <a href="/work" class="projects-link" aria-label="View my projects">
                                        See the projects →
                                </a>
                        </div>
                </div>

                <div id="education-wrapper">
                        <h3 class="skills-title">Education</h3>

                        <div class="education-list">
                                <article class="edu-card">
                                        <header class="edu-header">
                                                <h4 class="edu-degree">M.S. Computer Science</h4>
                                                <div class="edu-meta">
                                                        <span class="edu-status">Aug. 2024 — Expected Graduation: May. 2026</span>
                                                </div>
                                        </header>

                                        <div class="edu-row">
                                                <div class="edu-institution">California State University - Long Beach</div>
                                                <div class="edu-location">Long Beach, CA</div>
                                        </div>

                                        <div class="edu-gpa"><strong>GPA:</strong> 3.75</div>

                                        <div class="edu-coursework">
                                                <div class="coursework-header">
                                                        <strong>Coursework:</strong>
                                                        {csulbPost && (
                                                                <a href={`/posts/${csulbPost.id}`} class="coursework-link">View Detailed Archive</a>
                                                        )}
                                                </div>
                                                <div class="coursework-grid">
                                                        <ul class="course-list">
                                                                <li>Artificial Intelligence</li>
                                                                <li>Machine Vision</li>
                                                                <li>Search Engine Technology</li>

                                                        </ul>
                                                        <ul class="course-list">
                                                                <li>Advanced Algorithms</li>
                                                                <li>Advanced Software Engineering</li>
                                                                <li>Software Maintenance &amp Testing</li>
                                                        </ul>
                                                </div>
                                        </div>
                                </article>

                                <article class="edu-card">
                                        <header class="edu-header">
                                                <h4 class="edu-degree">B.S. Human Computer Interaction <span class="edu-minor-inline">Minor in Computer Science</span></h4>
                                                <div class="edu-meta">
                                                        <span class="edu-status">Oct. 2020 — June 2023</span>
                                                </div>
                                        </header>

                                        <div class="edu-row">
                                                <div class="edu-institution">University of California San Diego</div>
                                                <div class="edu-location">San Diego, CA</div>
                                        </div>

                                        <div class="edu-gpa"><strong>GPA:</strong> 3.52</div>

                                        <div class="edu-coursework">
                                                <div class="coursework-header">
                                                        <strong>Coursework:</strong>
                                                        {ucsdPost && (
                                                                <a href={`/posts/${ucsdPost.id}`} class="coursework-link">View Detailed Archive</a>
                                                        )}
                                                </div>
                                                <div class="coursework-grid">
                                                        <ul class="course-list">
                                                                <li>Front-end Development</li>
                                                                <li>Back-end Development</li>
                                                                <li>User-Interface Design</li>
                                                        </ul>
                                                        <ul class="course-list">
                                                                <li>Advanced Data Structures</li>
                                                                <li>Data Science</li>
                                                                <li>Social Computing</li>
                                                        </ul>
                                                </div>
                                        </div>
                                </article>
                        </div>
                </div>
        </div>
</section>

