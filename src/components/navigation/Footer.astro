---
import { Icon } from "astro-icon/components";
import "./Footer.css";
---
 
<footer id="footer">
  <div class="footer-container">
    <p class="copyright">© 2026 Jeffrey Luu</p>
    
    <div class="footer-links">
      <a
        class="footer-link"
        href="mailto:jluuruncs@gmail.com"
        aria-label="Contact me by email!"
      >
        <Icon name="lucide:mail" class="svg-icon" id="email-icon" aria-hidden="true" />
      </a>
      <a
        class="footer-link"
        href="https://github.com/jdluu"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Click here for my GitHub profile!"
      >
        <Icon name="lucide:github" class="svg-icon" id="github-icon" aria-hidden="true" />
      </a>
      <a
        class="footer-link"
        href="https://www.linkedin.com/in/jeffrey-luu"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Click here for my LinkedIn profile!"
      >
        <Icon name="lucide:linkedin" class="svg-icon" id="linkedin-icon" aria-hidden="true" />
      </a>
      <a
        class="footer-link"
        href="https://drive.google.com/file/d/1NvgQjI2QdMaA8ZI_vNpvlE9Gw7032Ddk/view"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Resume"
      >
        <Icon name="lucide:file-text" class="svg-icon" id="resume-icon" aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>
