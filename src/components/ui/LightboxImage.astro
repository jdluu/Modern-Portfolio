---
/**
 * LightboxImage component.
 * 
 * Renders an image that opens in a full-screen lightbox modal when clicked.
 * Supports both standard string URLs and Astro's optimized ImageMetadata.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

interface Props {
  /** The source of the image (string URL or ImageMetadata). */
  src: string | ImageMetadata;
  /** Accessible alt text for the image. */
  alt: string;
}

const { src, alt } = Astro.props;

// Determine if the source is an optimized Astro image object or a plain string
const isAstroImage = typeof src !== "string";
---

<aside class="aside" aria-labelledby="post-hero">
  <figure class="hero" id="post-hero">
    <button
      type="button"
      class="hero-trigger"
      aria-label="Open image in full size"
      aria-controls="image-lightbox"
      aria-expanded="false"
    >
      {isAstroImage ? (
        <Image src={src as ImageMetadata} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <img src={src as string} alt={alt} loading="lazy" decoding="async" />
      )}
    </button>
  </figure>
</aside>

<!-- Lightbox Modal -->
<div id="image-lightbox" class="lightbox is-hidden" hidden data-open="false" aria-hidden="true">
  <div class="lightbox-content" role="dialog" aria-modal="true" aria-label={`${alt} full size`} tabindex="-1">
    {isAstroImage ? (
      <Image src={src as ImageMetadata} alt={`${alt} full size`} />
    ) : (
      <img src={src as string} alt={`${alt} full size`} />
    )}
    <button class="lightbox-close" type="button" aria-label="Close image" data-close>
      <Icon name="lucide:x" width="20" height="20" aria-hidden="true" />
    </button>
  </div>
</div>

<script>
  /**
   * Client-side lightbox controller.
   * Handles opening/closing, focus management, and keyboard accessibility.
   */
  (() => {
    const lightboxEl = document.getElementById('image-lightbox');
    const trigger = document.querySelector('.hero .hero-trigger') as HTMLElement | null;
    if (!lightboxEl || !trigger) return;

    const triggerEl = trigger;
    const lb = lightboxEl;
    const closeBtn = lb.querySelector('[data-close]') as HTMLElement | null;
    let lastFocusedEl: HTMLElement | null = null;

    /** Opens the lightbox and locks body scroll. */
    function open() {
      lastFocusedEl = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      lb.classList.remove('is-hidden');
      
      // Toggle inert property for accessibility if supported
      if ('inert' in lb) {
        (lb as any).inert = false;
      }
      
      lb.removeAttribute('hidden');
      lb.setAttribute('data-open', 'true');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      triggerEl.setAttribute('aria-expanded', 'true');
      
      if (closeBtn) closeBtn.focus();
      document.addEventListener('keydown', onDocumentKeydown);
    }

    /** Closes the lightbox and restores scroll. */
    function close() {
      lb.classList.add('is-hidden');
      
      if ('inert' in lb) {
        (lb as any).inert = true;
      }
      
      lb.setAttribute('hidden', '');
      lb.setAttribute('data-open', 'false');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      triggerEl.setAttribute('aria-expanded', 'false');
      
      if (lastFocusedEl) lastFocusedEl.focus();
      document.removeEventListener('keydown', onDocumentKeydown);
    }

    function onDocumentKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape' || e.key === 'Esc') {
        if (lb.getAttribute('data-open') === 'true') {
          e.preventDefault();
          close();
        }
      }
    }

    triggerEl.addEventListener('click', open);

    // Close when clicking backdrop or close button
    lb.addEventListener('click', (e: Event) => {
      const evt = e as MouseEvent;
      if (!(evt.target instanceof Element)) return;
      if (evt.target === lb || !!evt.target.closest('[data-close]')) {
        close();
      }
    });
  })();
</script>
