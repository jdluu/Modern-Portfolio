    "@astrojs/solid-js": "^6.0.1",
    "@iconify-json/lucide": "^1.2.102",
    "astro": "^6.1.7",
    "astro-icon": "^1.1.5",
    "sharp": "^0.34.5",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "knip": "^6.4.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "terser": "^5.46.1",
