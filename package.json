{
  "name": "modern-portfolio",
  "type": "module",
  "version": "3.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "knip": "knip",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/solid-js": "^6.0.1",
    "astro": "^6.3.1",
    "astro-icon": "^1.1.5",
    "sharp": "^0.34.5",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.7",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.107",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "knip": "^6.13.1",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "rehype-slug": "^6.0.0",
    "terser": "^5.47.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7",
      "yaml": "^2.9.0"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,astro}": "eslint --fix",
    "**/*": "prettier --write --ignore-unknown"
  }
