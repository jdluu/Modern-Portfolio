{
  "name": "modern-portfolio",
  "type": "module",
  "version": "3.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "knip": "knip",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/solid-js": "^7.0.2",
    "astro": "^7.2.4",
    "astro-icon": "^1.2.0",
    "sharp": "^0.35.3",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.11",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.125",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-solid": "^0.16.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rehype-slug": "^6.0.0",
    "terser": "^5.50.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7",
      "yaml": "^2.9.0"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,astro}": "eslint --fix",
    "**/*": "prettier --write --ignore-unknown"
  }
}
